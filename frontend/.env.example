# Copy to frontend/.env and adjust. The React dev server reads these; the
# backend test suite also uses REACT_APP_BACKEND_URL as its API target
# (environment variable first, then this file). Real .env files are
# gitignored; never commit them.

# Base URL of the running backend API (no trailing slash).
REACT_APP_BACKEND_URL=http://127.0.0.1:8000

# Port for the React dev server.
PORT=8001
