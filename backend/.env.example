# Copy to backend/.env and adjust. Loaded by the server and by
# backend/tests/conftest.py (python-dotenv). Real .env files are gitignored;
# never commit them.

# MongoDB connection string. Transactional frame persistence requires a
# replica set (a single-node rs0 is fine for local development).
MONGO_URL=mongodb://127.0.0.1:27017/?replicaSet=rs0

# Database name the kernel writes to.
DB_NAME=simulation_sandbox

# Comma-separated list of allowed CORS origins for the API.
CORS_ORIGINS=http://localhost:8001,http://127.0.0.1:8001
