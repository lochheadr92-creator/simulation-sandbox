@@ -0,0 +1,275 @@
+"""Stage 8C Leg A evidence tooling: acceptance-gate metrics for the
+aid-exchange registry (`aid-exchange-000`) over a standard 1,000-tick
+collective_groups run, on the calibrated tree (RESPOND_AID 3334).
+
+Read-only. Runs the real committed pipeline exactly like
+_probe_8b_carriage_registry_state.py (pure kernel, seed
+"living-agents-stage6"), sampling per tick:
+
+  1. registry serialized bytes (the validator's own payload accounting:
+     len(canonical_json(registry).encode("utf-8"))) -> peak vs
+     payload_target_bytes, headroom percent (invariant 4 needs >=20%);
+  2. completed_exchange_count trajectory (G1 needs >=1) with each
+     completion's tick / request_id / requester / responder;
+  3. completion episodes per pre-registration SS9 (request->response->
+     completion cycles bounded by the due_tick = opened+8 window) - raw
+     distribution reported, K deliberately NOT proposed here;
+  4. request lifecycle stats: opened / expired / completed, per-request
+     outcome (tracked tick-by-tick, so compaction cannot hide a terminal);
+  5. deaths over the run (gate requires 0) and final alive count;
+  6. RESPOND_AID goal selections (living_settlement diagnostics) and
+     accepted `social_give` events, confirming the calibration organically.
+
+Incremental flush every 10 ticks (the Phase B run-plan pattern) to the
+output path so a wall-cap kill still leaves usable evidence.
+
+Usage: python -m tools._probe_8c_lega_gate_metrics [ticks] [out_path]
+"""
+from __future__ import annotations
+
+import json
+import sys
+import time
+
+from core.constants import ENGINE_VERSION, SCHEMA_VERSION
+from core.hashing import canonical_json
+from core.kernel import build_genesis, run_tick
+from core.rng import DeterministicRNG
+from scenarios import get_scenario
+from domains.aid_exchange_contracts import (
+    AID_EXCHANGE_REGISTRY_ID,
+    AID_REQUEST_DUE_TICKS,
+    LIMITS,
+    PROPOSAL_TYPE,
+)
+
+SEED = "living-agents-stage6"
+FLUSH_EVERY = 10
+DEFAULT_OUT = "/tmp/probe_lega_gate.json"
+
+
+def _alive_ids(entities):
+    return sorted(
+        eid for eid, e in entities.items()
+        if isinstance(e, dict) and e.get("type") == "person" and e.get("alive", True)
+    )
+
+
+def _episodes(completions):
+    """Cluster completion cycles into episodes: consecutive completions whose
+    completed_ticks are separated by more than the due window
+    (AID_REQUEST_DUE_TICKS = 8, the SS9 episode bound) start a new episode.
+    The raw per-completion cycles are always reported alongside, so K can be
+    derived independently of this clustering."""
+    episodes = []
+    for comp in sorted(completions, key=lambda c: (c["completed_tick"], c["request_id"])):
+        if episodes and comp["completed_tick"] - episodes[-1]["last_completed_tick"] <= AID_REQUEST_DUE_TICKS:
+            ep = episodes[-1]
+            ep["completions"].append(comp["request_id"])
+            ep["last_completed_tick"] = comp["completed_tick"]
+            ep["completion_count"] += 1
+        else:
+            episodes.append({
+                "first_completed_tick": comp["completed_tick"],
+                "last_completed_tick": comp["completed_tick"],
+                "completion_count": 1,
+                "completions": [comp["request_id"]],
+            })
+    return episodes
+
+
+def probe(ticks=1000, out_path=DEFAULT_OUT):
+    scenario = get_scenario("collective_groups")
+    lineage_key = f"{SEED}|{SCHEMA_VERSION}|{ENGINE_VERSION}"
+    world, entities, genesis, _rej, order_index = build_genesis(SEED, scenario, lineage_key)
+    valid_parent_ids = {e["id"] for e in genesis}
+    rng = DeterministicRNG(SEED)
+
+    requests = {}           # request_id -> tracked lifecycle record
+    completions = []        # [{request_id, completed_tick, requester, responder, response_event_id}]
+    count_trajectory = []   # [(tick, completed_exchange_count)] on change only
+    respond_aid_selections = []   # [{tick, entity_id, goal_id}]
+    social_give_events = []       # [{tick, event_id, actor, target}]
+    aid_event_count = 0
+    aid_reject_reasons = {}
+    death_ticks = []
+    peak_bytes = 0
+    peak_bytes_tick = None
+    last_count = 0
+    alive_before = set(_alive_ids(entities))
+    started = time.time()
+
+    def result_snapshot(done_ticks, final=False):
+        outcome_counts = {"open_at_end": 0, "expired": 0, "completed": 0}
+        for rec in requests.values():
+            outcome_counts[rec["outcome"] or "open_at_end"] = \
+                outcome_counts.get(rec["outcome"] or "open_at_end", 0) + 1
+        registry = entities.get(AID_EXCHANGE_REGISTRY_ID) or {}
+        alive_now = _alive_ids(entities)
+        final_count = int(registry.get("completed_exchange_count", 0))
+        headroom_pct = round(
+            (LIMITS.payload_target_bytes - peak_bytes) * 100.0 / LIMITS.payload_target_bytes, 2,
+        )
+        episodes = _episodes(completions)
+        return {
+            "probe": "stage8c-lega-gate-metrics",
+            "seed": SEED,
+            "scenario": "collective_groups",
+            "ticks_requested": ticks,
+            "ticks_completed": done_ticks,
+            "final": final,
+            "calibration_note": "RESPOND_AID priority 3334 (calibrated tree)",
+            "registry_bytes": {
+                "peak_serialized_bytes": peak_bytes,
+                "peak_tick": peak_bytes_tick,
+                "payload_target_bytes": LIMITS.payload_target_bytes,
+                "proposal_bytes_cap": LIMITS.proposal_bytes,
+                "headroom_percent_vs_target": headroom_pct,
+                "invariant4_pass_ge_20pct": headroom_pct >= 20.0,
+                "final_serialized_bytes": len(canonical_json(registry).encode("utf-8")) if registry else 0,
+            },
+            "g1_completed_exchanges": {
+                "final_completed_exchange_count": final_count,
+                "count_trajectory": count_trajectory,
+                "completions": sorted(
+                    completions, key=lambda c: (c["completed_tick"], c["request_id"]),
+                ),
+                "g1_pass_ge_1": final_count >= 1,
+            },
+            "g3_episode_distribution": {
+                "episode_bound_ticks": AID_REQUEST_DUE_TICKS,
+                "episode_count": len(episodes),
+                "episodes": episodes,
+                "note": "raw distribution only; K is calibration-derived elsewhere",
+            },
+            "request_stats": {
+                "opened_total": len(requests),
+                "outcome_counts": outcome_counts,
+                "per_request": [
+                    {"request_id": rid, **requests[rid]} for rid in sorted(requests)
+                ],
+            },
+            "population": {
+                "alive_at_end": len(alive_now),
+                "alive_ids": alive_now,
+                "deaths": death_ticks,
+                "death_count": len(death_ticks),
+                "gate_zero_deaths_pass": not death_ticks,
+            },
+            "calibration_effect": {
+                "respond_aid_selection_count": len(respond_aid_selections),
+                "respond_aid_selections": respond_aid_selections,
+                "social_give_accepted_count": len(social_give_events),
+                "social_give_events": social_give_events,
+            },
+            "aid_exchange_events_accepted": aid_event_count,
+            "aid_exchange_reject_reasons": aid_reject_reasons,
+            "registry_revision": registry.get("revision"),
+            "wall_clock_seconds": round(time.time() - started, 2),
+        }
+
+    def flush(done_ticks, final=False):
+        with open(out_path, "w", encoding="utf-8") as fh:
+            json.dump(result_snapshot(done_ticks, final), fh, indent=2, default=str)
+
+    for tick in range(1, ticks + 1):
+        accepted, rejected, order_index, diags = run_tick(
+            "probe", entities, world["terrain"], tick, rng, order_index,
+            lineage_key, scenario.enabled_domains,
+            valid_causal_parent_event_ids=valid_parent_ids,
+        )
+        for e in accepted:
+            valid_parent_ids.add(e["id"])
+            if e["event_type"] == PROPOSAL_TYPE:
+                aid_event_count += 1
+            elif e["event_type"] == "social_give":
+                social_give_events.append({
+                    "tick": tick, "event_id": e["id"], "actor": e["entity_id"],
+                    "target": (e.get("social_action") or {}).get("target_id"),
+                })
+        for r in rejected:
+            if r["entity_id"] == AID_EXCHANGE_REGISTRY_ID:
+                aid_reject_reasons[r["reason_code"]] = \
+                    aid_reject_reasons.get(r["reason_code"], 0) + 1
+
+        for entity_id in sorted(diags):
+            diag = diags[entity_id]
+            if isinstance(diag, dict) and diag.get("selected_goal") == "RESPOND_AID":
+                respond_aid_selections.append({
+                    "tick": tick, "entity_id": entity_id, "goal_id": diag.get("goal_id"),
+                })
+
+        registry = entities.get(AID_EXCHANGE_REGISTRY_ID)
+        if isinstance(registry, dict):
+            size = len(canonical_json(registry).encode("utf-8"))
+            if size > peak_bytes:
+                peak_bytes, peak_bytes_tick = size, tick
+            for rid in sorted(registry.get("open_requests") or {}):
+                record = registry["open_requests"][rid]
+                tracked = requests.get(rid)
+                if tracked is None:
+                    tracked = requests[rid] = {
+                        "requester_id": record.get("requester_id"),
+                        "responder_id": record.get("responder_id"),
+                        "opened_tick": record.get("opened_tick"),
+                        "due_tick": record.get("due_tick"),
+                        "source_event_id": record.get("source_event_id"),
+                        "outcome": None,
+                        "outcome_tick": None,
+                    }
+                status = record.get("status")
+                if status != "open" and tracked["outcome"] is None:
+                    tracked["outcome"] = status
+                    tracked["outcome_tick"] = tick
+            count = int(registry.get("completed_exchange_count", 0))
+            if count != last_count:
+                count_trajectory.append([tick, count])
+                ledger = registry.get("completions") or {}
+                for rid in sorted(ledger):
+                    if any(c["request_id"] == rid for c in completions):
+                        continue
+                    tracked = requests.get(rid) or {}
+                    completions.append({
+                        "request_id": rid,
+                        "completed_tick": int(ledger[rid].get("completed_tick", tick)),
+                        "response_event_id": ledger[rid].get("response_event_id"),
+                        "requester_id": tracked.get("requester_id"),
+                        "responder_id": tracked.get("responder_id"),
+                        "opened_tick": tracked.get("opened_tick"),
+                        "due_tick": tracked.get("due_tick"),
+                    })
+                last_count = count
+
+        alive_now = set(_alive_ids(entities))
+        for dead in sorted(alive_before - alive_now):
+            death_ticks.append({"tick": tick, "entity_id": dead})
+        alive_before = alive_now
+
+        if tick % FLUSH_EVERY == 0:
+            flush(tick)
+
+    flush(ticks, final=True)
+    summary = result_snapshot(ticks, final=True)
+    # Concise stdout summary (full detail lives in out_path).
+    print(json.dumps({
+        "G1": "PASS" if summary["g1_completed_exchanges"]["g1_pass_ge_1"] else "FAIL",
+        "final_completed_exchange_count": summary["g1_completed_exchanges"]["final_completed_exchange_count"],
+        "peak_registry_bytes": summary["registry_bytes"]["peak_serialized_bytes"],
+        "headroom_percent": summary["registry_bytes"]["headroom_percent_vs_target"],
+        "invariant4_pass": summary["registry_bytes"]["invariant4_pass_ge_20pct"],
+        "episode_count": summary["g3_episode_distribution"]["episode_count"],
+        "requests": summary["request_stats"]["outcome_counts"],
+        "deaths": summary["population"]["death_count"],
+        "alive_at_end": summary["population"]["alive_at_end"],
+        "respond_aid_selections": summary["calibration_effect"]["respond_aid_selection_count"],
+        "social_give_accepted": summary["calibration_effect"]["social_give_accepted_count"],
+        "out_path": out_path,
+    }, indent=2))
+
+
+if __name__ == "__main__":
+    tk = int(sys.argv[1]) if len(sys.argv) > 1 else 1000
+    out = sys.argv[2] if len(sys.argv) > 2 else DEFAULT_OUT
+    t0 = time.time()
+    probe(tk, out)
+    print(json.dumps({"wall_clock_seconds": round(time.time() - t0, 2)}), file=sys.stderr)
-- 
