+"""Stage 8C Leg A completion diagnostic probe (read-only, observation-only).
+
+Question: 44 social_request_help accepted / 35 aid_exchange_progress events in
+the 1000-tick collective_groups run, but ZERO give actions ever committed.
+Which gate in the RESPOND_AID -> give pipeline is the dominant blocker?
+
+Runs the committed collective_groups tick loop (seed living-agents-stage6)
+via the same build_genesis/run_tick primitives as the other _probe_8c_*.py
+scripts. NO monkey-patching, NO module assignment, NO engine/domain file is
+modified. All observations are scalar copies taken off the live objects; the
+only extra calls into domain code are pure functions on deepcopies
+(perceive_living - no rng argument, builds a fresh observation package).
+
+Per tick, for every OPEN unexpired aid request (pre-tick registry frame, i.e.
+exactly what build_settlement_candidates sees at this tick):
+  - responder carried food (pre-tick frame)
+  - manhattan + chebyshev responder->requester distance (social adjacency in
+    build_social_action_proposal is MANHATTAN <= 1, living_agent_social.py:245)
+  - requester visibility via a read-only perceive_living call on deepcopies
+    (night=is_night(tick), weather from the pre-tick frame - mirrors the
+    domain call site living_settlement_domain.py:558)
+Post-tick, from the responder's committed decision receipt
+(living_agent.current_decision - retains full candidate scoring):
+  - was RESPOND_AID among the generated candidates, was it selected, what won
+  - the executed action type (entity["action"]["type"])
+Plus every accepted social_give, every rejected proposal whose goal is
+RESPOND_AID or whose type is social_give (reason codes), and every
+aid_exchange_progress transition list.
+
+Incremental flush after every checkpoint and in a finally block (durability
+pattern from _probe_8c_response_side.py).
+
+Usage: python -m tools._probe_8c_lega_completion_diag <target_ticks> <out_json>
+"""
+from __future__ import annotations
+
+import copy
+import json
+import sys
+import time
+from collections import Counter
+
+from core.kernel import build_genesis, run_tick
+from core.rng import DeterministicRNG
+from core.constants import ENGINE_VERSION, SCHEMA_VERSION, is_night
+from scenarios import get_scenario
+from domains.living_agent_cognition import perceive_living
+from domains.aid_exchange_contracts import AID_EXCHANGE_REGISTRY_ID, STATUS_OPEN
+
+SEED = "living-agents-stage6"
+SCENARIO_ID = "collective_groups"
+CHECKPOINT_EVERY = 10
+MAX_WALL_SECONDS = 3000.0   # diagnostic-only wall cap; incremental flush keeps partials usable
+RESPOND_GOAL = "RESPOND_AID"
+
+
+def _food(entity):
+    return int(((entity or {}).get("carried_resources") or {}).get("food", 0))
+
+
+def _alive_people(entities):
+    return {eid: e for eid, e in entities.items()
+            if isinstance(e, dict) and e.get("type") == "person" and e.get("alive", True)}
+
+
+def _dists(a, b):
+    if not a or not b:
+        return None, None
+    dx = abs(a["x"] - b["x"])
+    dy = abs(a["y"] - b["y"])
+    return dx + dy, max(dx, dy)   # manhattan, chebyshev
+
+
+def probe(target_ticks, out_path):
+    scenario = get_scenario(SCENARIO_ID)
+    lineage_key = f"{SEED}|{SCHEMA_VERSION}|{ENGINE_VERSION}"
+    world, entities, genesis, _rej, order_index = build_genesis(SEED, scenario, lineage_key)
+    valid_parent_ids = {e["id"] for e in genesis}
+    rng = DeterministicRNG(SEED)
+
+    requests = {}            # request_id -> aggregate record with per-tick samples
+    give_accepted = []       # accepted social_give events
+    give_rejected = []       # rejected proposals: goal RESPOND_AID or type social_give
+    aid_transitions = []     # aid_exchange_progress transition lists
+    accepted_by_type = Counter()
+    food_at_open = []        # all-agent carried-food snapshot at each request open
+
+    state = {"ticks_run": 0, "truncated": False, "stopped_reason": None}
+    t0 = time.time()
+    last_checkpoint = t0
+
+    def build_result():
+        return {
+            "scenario": SCENARIO_ID, "seed": SEED,
+            "target_ticks_at_stop": target_ticks,
+            "ticks_run": state["ticks_run"],
+            "truncated": state["truncated"],
+            "stopped_reason": state["stopped_reason"],
+            "wall_clock_seconds": round(time.time() - t0, 2),
+            "requests": {rid: requests[rid] for rid in sorted(requests)},
+            "give_accepted": give_accepted,
+            "give_rejected": give_rejected,
+            "aid_transitions": aid_transitions,
+            "food_at_open_moments": food_at_open,
+            "accepted_by_type": dict(sorted(accepted_by_type.items())),
+        }
+
+    def flush():
+        try:
+            with open(out_path, "w", encoding="utf-8") as fh:
+                json.dump(build_result(), fh, indent=1, default=str)
+        except Exception as exc:
+            print(json.dumps({"flush_error": str(exc)}), file=sys.stderr, flush=True)
+
+    def _goal_of(entity_id, container):
+        upd = ((container.get("mutation") or {}).get("entity_updates") or {}).get(entity_id) or {}
+        return upd.get("current_goal")
+
+    try:
+        for tick in range(1, target_ticks + 1):
+            # ---- PRE-TICK: this is the frame build_settlement_candidates reads at `tick`.
+            registry = entities.get(AID_EXCHANGE_REGISTRY_ID) or {}
+            open_reqs = registry.get("open_requests") or {}
+            eligible = []   # (request_id, record) open AND unexpired at this tick
+            pre = {}
+            for rid in sorted(open_reqs):
+                rec = open_reqs[rid]
+                if not isinstance(rec, dict) or rec.get("status") != STATUS_OPEN:
+                    continue
+                responder_id = rec.get("responder_id")
+                requester_id = rec.get("requester_id")
+                unexpired = int(tick) < int(rec.get("due_tick", tick))
+                responder = entities.get(responder_id) or {}
+                requester = entities.get(requester_id) or {}
+                mdist, cdist = _dists(responder.get("position"), requester.get("position"))
+                visible = None
+                if unexpired and responder.get("alive", True):
+                    # Read-only replica of the domain's perception call, on deepcopies.
+                    snap = copy.deepcopy(entities)
+                    delta = perceive_living(
+                        responder_id, snap[responder_id], snap, world["terrain"], tick,
+                        night=is_night(tick), weather=snap.get("weather-000"),
+                    )
+                    people = {o["observed_subject_id"] for o in delta.get("observations") or []
+                              if o.get("observation_type") == "person"}
+                    visible = requester_id in people
+                sample = {
+                    "tick": tick,
+                    "unexpired": unexpired,
+                    "ticks_remaining": int(rec.get("due_tick", tick)) - int(tick),
+                    "responder_food": _food(responder),
+                    "responder_alive": responder.get("alive", True),
+                    "requester_alive": requester.get("alive", True),
+                    "manhattan": mdist, "chebyshev": cdist,
+                    "requester_visible": visible,
+                    "responder_hunger": int(responder.get("hunger", 0)),
+                }
+                pre[rid] = sample
+                if rid not in requests:
+                    requests[rid] = {
+                        "request_id": rid,
+                        "requester_id": requester_id, "responder_id": responder_id,
+                        "opened_tick": rec.get("opened_tick"), "due_tick": rec.get("due_tick"),
+                        "samples": [],
+                        "final_status": None,
+                    }
+                if unexpired:
+                    eligible.append((rid, responder_id))
+
+            accepted, rejected, order_index, _diag = run_tick(
+                "probe", entities, world["terrain"], tick, rng, order_index,
+                lineage_key, scenario.enabled_domains,
+                valid_causal_parent_event_ids=valid_parent_ids,
+            )
+            state["ticks_run"] = tick
+
+            # ---- POST-TICK: decision receipts for this tick's eligible responders.
+            for rid, responder_id in eligible:
+                receipt = ((entities.get(responder_id) or {}).get("living_agent") or {}).get("current_decision") or {}
+                sample = pre[rid]
+                if receipt.get("tick") == tick:
+                    goals = [g.get("goal") for g in receipt.get("candidate_goals") or []]
+                    sample["n_candidates"] = len(goals)
+                    sample["respond_aid_generated"] = RESPOND_GOAL in goals
+                    sample["selected_goal"] = receipt.get("selected_goal")
+                    sample["selected_score"] = receipt.get("selected_score")
+                    sample["decision_kind"] = receipt.get("decision_kind")
+                    if RESPOND_GOAL in goals:
+                        row = next(g for g in receipt.get("candidate_goals") or []
+                                   if g.get("goal") == RESPOND_GOAL)
+                        sample["respond_aid_score"] = row.get("score_total")
+                    action = (entities.get(responder_id) or {}).get("action") or {}
+                    sample["executed_action"] = action.get("type")
+                    sample["executed_target"] = action.get("target_entity_id")
+                else:
+                    sample["no_receipt_this_tick"] = True
+            for rid in pre:
+                requests[rid]["samples"].append(pre[rid])
+                # refresh terminal status from the post-tick registry
+                post_rec = ((entities.get(AID_EXCHANGE_REGISTRY_ID) or {}).get("open_requests") or {}).get(rid)
+                if isinstance(post_rec, dict):
+                    requests[rid]["final_status"] = post_rec.get("status")
+
+            # ---- events
+            for r in rejected:
+                snap = r.get("proposal_snapshot") or {}
+                goal = _goal_of(snap.get("entity_id"), snap)
+                if snap.get("proposal_type") == "social_give" or goal == RESPOND_GOAL:
+                    give_rejected.append({"tick": tick, "actor_id": r.get("entity_id"),
+                        "goal": goal, "proposal_type": snap.get("proposal_type"),
+                        "reason_code": r.get("reason_code"), "reason_detail": r.get("reason_detail")})
+            for e in accepted:
+                valid_parent_ids.add(e["id"])
+                etype = e.get("event_type")
+                accepted_by_type[etype] += 1
+                if etype == "social_give":
+                    sa = e.get("social_action") or {}
+                    give_accepted.append({"tick": tick, "actor_id": e.get("entity_id"),
+                        "target_id": sa.get("target_id"), "goal": _goal_of(e.get("entity_id"), e)})
+                if etype == "aid_exchange_progress":
+                    meta = e.get("aid_exchange_update") or {}
+                    aid_transitions.append({"tick": tick,
+                        "transitions": meta.get("transitions"),
+                        "open_request_count": meta.get("open_request_count"),
+                        "completed_exchange_count": meta.get("completed_exchange_count")})
+                    for entry in ((meta.get("changes") or {}).get("opens") or []):
+                        food_at_open.append({"tick": tick,
+                            "request_id": entry.get("request_id"),
+                            "requester_id": entry.get("requester_id"),
+                            "responder_id": entry.get("responder_id"),
+                            "all_agent_food": {pid: _food(p) for pid, p in
+                                               sorted(_alive_people(entities).items())}})
+
+            if tick % CHECKPOINT_EVERY == 0 or tick == target_ticks:
+                now = time.time()
+                print(json.dumps({"checkpoint_tick": tick,
+                    "cumulative_seconds": round(now - t0, 2),
+                    "window_seconds": round(now - last_checkpoint, 2),
+                    "requests_seen": len(requests),
+                    "give_accepted": len(give_accepted),
+                    "give_rejected": len(give_rejected)}), file=sys.stderr, flush=True)
+                last_checkpoint = now
+                flush()
+
+            if len(_alive_people(entities)) < 2:
+                state["stopped_reason"] = "population_cannot_produce_pairs"
+                break
+            if (time.time() - t0) >= MAX_WALL_SECONDS:
+                state["truncated"] = True
+                state["stopped_reason"] = "wall_time_cap"
+                break
+        else:
+            state["stopped_reason"] = "reached_target_ticks"
+    except Exception as exc:
+        import traceback
+        state["stopped_reason"] = f"exception:{type(exc).__name__}:{exc}"
+        traceback.print_exc()
+    finally:
+        flush()
+    return build_result()
+
+
+if __name__ == "__main__":
+    tk = int(sys.argv[1]) if len(sys.argv) > 1 else 350
+    out = sys.argv[2] if len(sys.argv) > 2 else "/tmp/probe_lega_diag.json"
