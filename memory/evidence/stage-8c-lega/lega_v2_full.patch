+"""Stage 8C Leg A proposal-only aid-exchange domain (request lifecycle:
+open, expire, complete; norm formation is calibration-gated).
+Contract: memory/CAPABILITY-STAGE-8C-LEGA-AID-EXCHANGE.md.
+"""
+from __future__ import annotations
+
+from domains.base import DomainEngine, DomainOutput
+from domains.aid_exchange_contracts import (
+    AID_EXCHANGE_REGISTRY_ID,
+    aid_exchange_diagnostics,
+    build_aid_exchange_proposal,
+)
+
+
+class AidExchangeDomain(DomainEngine):
+    engine_id = "aid_exchange"
+    engine_version = "1.0.0"
+    # Prior-frame semantics: like every domain in this kernel, proposals are
+    # built from the entities_view frozen at the end of the previous tick
+    # (core/kernel.py:73) - engine_priority governs commit/validation order
+    # only. 85 is the next culture-ladder slot below group_carriage (86),
+    # per the later-stage-commits-earlier rule for registry writes (D6).
+    engine_priority = 85
+    phase = "agent"
+
+    def select_due_ids(self, entities: dict, tick: int) -> list:
+        # No upstream registry gate - this domain rides person accepted
+        # actions only (D2). Due whenever any living person exists.
+        for entity_id in sorted(entities):
+            entity = entities[entity_id]
+            if entity.get("type") == "person" and entity.get("alive", True):
+                return [AID_EXCHANGE_REGISTRY_ID]
+        return []
+
+    def activate(self, frame) -> DomainOutput:
+        if not frame.due_entity_ids:
+            return DomainOutput()
+        proposals = []
+        proposal = build_aid_exchange_proposal(frame.entities, frame.simulation_time)
+        if proposal is not None:
+            proposals.append(proposal)
+        diagnostics = {}
+        registry = None
+        if proposal is not None:
+            mutation = proposal["mutation"]
+            registry = (
+                (mutation.get("new_entities") or {}).get(AID_EXCHANGE_REGISTRY_ID)
+                or (mutation.get("entity_updates") or {}).get(AID_EXCHANGE_REGISTRY_ID)
+            )
+        elif AID_EXCHANGE_REGISTRY_ID in frame.entities:
+            registry = frame.entities[AID_EXCHANGE_REGISTRY_ID]
+        if registry:
+            diagnostics[AID_EXCHANGE_REGISTRY_ID] = aid_exchange_diagnostics(
+                registry, frame.simulation_time,
+            )
+        return DomainOutput(proposals=proposals, diagnostics=diagnostics)
