diff --git a/backend/tests/test_stage8c_lega_aid_exchange.py b/backend/tests/test_stage8c_lega_aid_exchange.py
new file mode 100644
index 00000000..02958072
--- /dev/null
+++ b/backend/tests/test_stage8c_lega_aid_exchange.py
@@ -0,0 +1,546 @@
+"""Stage 8C Leg A aid-exchange focused + integrated tests.
+
+Contract: memory/CAPABILITY-STAGE-8C-LEGA-AID-EXCHANGE.md (CONFIRMED).
+Patterns follow tests/test_stage8b_leg1_norm_transmission.py.
+"""
+from __future__ import annotations
+
+import copy
+
+from core.commit_pipeline import run_commit_frame
+from core.mutations import apply_mutation
+from domains.base import DomainOutput
+from domains.aid_exchange_contracts import (
+    AID_EXCHANGE_REGISTRY_ID,
+    AID_EXCHANGE_REGISTRY_VERSION,
+    AID_NORM_FORMATION_COUNT,
+    AID_REQUEST_DUE_TICKS,
+    LIMITS,
+    PROPOSAL_TYPE,
+    REASON_INVALID,
+    REASON_METADATA,
+    REASON_PAYLOAD,
+    REASON_REGISTRY_ID,
+    REASON_SCOPE,
+    STATUS_COMPLETED,
+    STATUS_EXPIRED,
+    STATUS_OPEN,
+    advance_aid_exchange_registry,
+    aid_request_id,
+    build_aid_exchange_proposal,
+    derive_aid_exchange_changes,
+    empty_aid_exchange_registry,
+    validate_aid_exchange_proposal,
+)
+from domains.living_settlement_domain import build_settlement_candidates
+
+LINEAGE = "stage8c-lega-lineage"
+RUN = "stage8c-lega-run"
+REQUESTER = "p-r"
+RESPONDER = "p-h"
+
+
+def _person(pid, *, alive=True, action=None, food=0):
+    ent = {
+        "type": "person", "alive": alive, "living_agent": {"wants": {}},
+        "position": {"x": 0, "y": 0}, "last_event_id": "evt-0-" + pid,
+        "carried_resources": {"food": food},
+    }
+    if action is not None:
+        ent["action"] = action
+    return ent
+
+
+def _request_action(target_id, *, event_id="evt-req-1"):
+    """A committed accepted action of the qualifying request type (D2)."""
+    return {
+        "type": "request_help", "status": "completed",
+        "target_entity_id": target_id, "accepted_event_id": event_id,
+    }
+
+
+def _give_action(target_id, *, event_id="evt-give-1"):
+    """A committed accepted give (the D4 response; social_give at commit)."""
+    return {
+        "type": "give", "status": "completed",
+        "target_entity_id": target_id, "accepted_event_id": event_id,
+    }
+
+
+def _open_request(*, requester=REQUESTER, responder=RESPONDER, opened=10,
+                  source_event_id="evt-req-1", status=STATUS_OPEN):
+    return {
+        "requester_id": requester, "responder_id": responder,
+        "opened_tick": opened, "due_tick": opened + AID_REQUEST_DUE_TICKS,
+        "source_event_id": source_event_id, "status": status,
+        "created_event_id": "evt-open", "last_event_id": "evt-open",
+    }
+
+
+def _registry_with_request(*, opened=10, source_event_id="evt-req-1",
+                           status=STATUS_OPEN):
+    registry = empty_aid_exchange_registry(opened)
+    rid = aid_request_id(source_event_id)
+    registry["open_requests"][rid] = _open_request(
+        opened=opened, source_event_id=source_event_id, status=status,
+    )
+    registry["processed_request_event_ids"] = [source_event_id]
+    registry["revision"] = 1
+    return registry, rid
+
+
+def _entities(*, registry=None, requester_action=None, responder_action=None,
+              responder_food=0):
+    ents = {
+        REQUESTER: _person(REQUESTER, action=requester_action),
+        RESPONDER: _person(RESPONDER, action=responder_action, food=responder_food),
+    }
+    if registry is not None:
+        ents[AID_EXCHANGE_REGISTRY_ID] = registry
+    return ents
+
+
+def _commit(entities, proposals, tick, order=0):
+    return run_commit_frame(
+        entities, [DomainOutput(proposals=list(proposals))],
+        tick, LINEAGE, RUN, order, "frame-" + str(tick),
+    )
+
+
+# --- request opening --------------------------------------------------------
+
+def test_accepted_request_opens_registry_entry():
+    ents = _entities(requester_action=_request_action(RESPONDER))
+    changes = derive_aid_exchange_changes(ents, 11)
+    assert len(changes["opens"]) == 1
+    entry = changes["opens"][0]
+    assert entry["requester_id"] == REQUESTER
+    assert entry["responder_id"] == RESPONDER
+    assert entry["source_event_id"] == "evt-req-1"
+    assert not changes["completions"] and not changes["expiries"]
+    registry, transitions = advance_aid_exchange_registry(None, changes, 11)
+    rid = aid_request_id("evt-req-1")
+    record = registry["open_requests"][rid]
+    assert record["status"] == STATUS_OPEN
+    assert record["opened_tick"] == 11
+    assert record["due_tick"] == 11 + AID_REQUEST_DUE_TICKS  # cited legacy window
+    assert "evt-req-1" in registry["processed_request_event_ids"]
+    assert registry["completed_exchange_count"] == 0
+    assert transitions == [{"kind": "open", "request_id": rid}]
+
+
+def test_duplicate_request_event_is_idempotent_noop():
+    ents = _entities(requester_action=_request_action(RESPONDER))
+    proposal = build_aid_exchange_proposal(ents, 11)
+    accepted, rejected, _ = _commit(ents, [proposal], 11)
+    assert not rejected and len(accepted) == 1
+    # The same committed action observed again (entity action not yet
+    # overwritten) must not reopen: processed_request_event_ids guards it.
+    changes = derive_aid_exchange_changes(ents, 12)
+    assert not changes["opens"]
+    assert build_aid_exchange_proposal(ents, 12) is None
+
+
+def test_request_targeting_dead_responder_does_not_open():
+    ents = _entities(requester_action=_request_action(RESPONDER))
+    ents[RESPONDER]["alive"] = False
+    changes = derive_aid_exchange_changes(ents, 11)
+    assert not changes["opens"]
+
+
+# --- expiry -----------------------------------------------------------------
+
+def test_request_expires_at_due_tick():
+    registry, rid = _registry_with_request(opened=10)
+    due = 10 + AID_REQUEST_DUE_TICKS
+    ents = _entities(registry=registry)
+    assert not derive_aid_exchange_changes(ents, due - 1)["expiries"]
+    changes = derive_aid_exchange_changes(ents, due)
+    assert [e["request_id"] for e in changes["expiries"]] == [rid]
+    advanced, transitions = advance_aid_exchange_registry(registry, changes, due)
+    assert advanced["open_requests"][rid]["status"] == STATUS_EXPIRED
+    assert advanced["completed_exchange_count"] == 0  # expiry is never completion
+    assert transitions == [{"kind": "expire", "request_id": rid}]
+
+
+def test_expired_request_does_not_complete():
+    registry, rid = _registry_with_request(opened=10)
+    due = 10 + AID_REQUEST_DUE_TICKS
+    ents = _entities(registry=registry, responder_action=_give_action(REQUESTER))
+    changes = derive_aid_exchange_changes(ents, due)
+    assert not changes["completions"]  # past due: expiry only
+    assert [e["request_id"] for e in changes["expiries"]] == [rid]
+
+
+# --- completion ---------------------------------------------------------------
+
+def test_matched_give_completes_and_increments_counter():
+    registry, rid = _registry_with_request(opened=10)
+    ents = _entities(registry=registry, responder_action=_give_action(REQUESTER))
+    changes = derive_aid_exchange_changes(ents, 12)
+    assert len(changes["completions"]) == 1
+    entry = changes["completions"][0]
+    assert entry["request_id"] == rid
+    assert entry["response_event_id"] == "evt-give-1"
+    advanced, transitions = advance_aid_exchange_registry(registry, changes, 12)
+    assert advanced["open_requests"][rid]["status"] == STATUS_COMPLETED
+    assert advanced["completions"][rid] == {
+        "response_event_id": "evt-give-1", "completed_tick": 12,
+    }
+    assert advanced["completed_exchange_count"] == 1
+    assert transitions == [{"kind": "complete", "request_id": rid}]
+
+
+def test_give_to_wrong_target_does_not_complete():
+    registry, _rid = _registry_with_request(opened=10)
+    ents = _entities(registry=registry, responder_action=_give_action("p-other"))
+    ents["p-other"] = _person("p-other")
+    assert not derive_aid_exchange_changes(ents, 12)["completions"]
+
+
+def test_give_from_non_responder_does_not_complete():
+    registry, _rid = _registry_with_request(opened=10)
+    ents = _entities(registry=registry)
