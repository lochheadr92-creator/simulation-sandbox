+def test_completion_survives_same_frame_requester_churn():
+    """The give-completion commits through the real pipeline while the
+    REQUESTER also acts in the same frame (committed first, at priority 10):
+    completion detection reads only the responder's committed action, so the
+    re-derivation at validation time still matches byte-for-byte."""
+    registry, rid = _registry_with_request(opened=10)
+    ents = _entities(registry=registry, responder_action=_give_action(REQUESTER))
+    proposal = build_aid_exchange_proposal(ents, 12)
+    assert proposal is not None
+    frame = [_actor_action_overwrite(REQUESTER, 12), proposal]
+    accepted, rejected, _ = _commit(ents, frame, 12)
+    aid_rejections = [r for r in rejected if r["entity_id"] == AID_EXCHANGE_REGISTRY_ID]
+    assert not aid_rejections, f"aid_exchange rejected under churn: {aid_rejections}"
+    aid_events = [e for e in accepted if e["event_type"] == PROPOSAL_TYPE]
+    assert len(aid_events) == 1
+    assert ents[AID_EXCHANGE_REGISTRY_ID]["open_requests"][rid]["status"] == STATUS_COMPLETED
+    assert ents[AID_EXCHANGE_REGISTRY_ID]["completed_exchange_count"] == 1
+    assert ents[REQUESTER]["action"]["type"] == "rest"  # the churn really landed
