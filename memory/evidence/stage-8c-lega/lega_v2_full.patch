+"""Stage 8C Leg A - Aid exchange (delivery, response, completion).
+Contract: memory/CAPABILITY-STAGE-8C-LEGA-AID-EXCHANGE.md (CONFIRMED 2026-07-24).
+
+The legacy response path is broken and sealed (RESPOND_HELP never fires:
+request commitments never persist to the person being asked - the
+CORE-INTEGRITY-001 F1 same-frame lost update). This family therefore owns
+"who was asked" as its own canonical state (D1): a singleton registry
+``aid-exchange-000`` records each accepted ``social_request_help`` as an open
+request (D2), and records the responder's accepted ``give`` back to the
+requester as a completion (D4). Material delivery itself rides the person's
+own accepted give action (living_agent_social.build_social_action_proposal,
+committed at engine_priority 10) - this module NEVER writes person entities;
+every write it proposes is registry-local, which is exactly the surface
+CI-001 SS6 shows is NOT F1-exposed.
+
+Trigger seam: the same accepted-action seam Stage 7A and group_carriage
+already read (``entity["action"]`` + ``accepted_event_id``; see
+group_carriage_contracts._accepted_action) - no second communication engine.
+Standard prior-frame semantics: a request accepted at tick T is opened at
+T+1; a give accepted at tick T completes at T+1.
+
+Commit ordering: ``engine_priority = 85`` - the next culture-ladder slot
+below group_carriage (86), per the later-stage-commits-earlier rule for
+registry writes (D6 rider, confirmed). No upstream culture registry is
+pinned: this domain rides person actions only.
+
+Non-goals (Leg A, D8): no influence hook, no edits to sealed legacy
+(hunger>=600, REQUEST_HELP, RESPOND_HELP, commitment lifecycle), no CI-001
+remediation, no forgetting/expiry-punishment semantics, no generational
+pathway.
+"""
+from __future__ import annotations
+
+import copy
+from dataclasses import dataclass
+
+from core.hashing import canonical_hash, canonical_json
+
+
+AID_EXCHANGE_REGISTRY_ID = "aid-exchange-000"
+AID_EXCHANGE_REGISTRY_VERSION = "aid-exchange-registry-v1"
+AID_EXCHANGE_VERSION = "aid-exchange-v1"
+
+PROPOSAL_TYPE = "aid_exchange_progress"
+PROPOSAL_FAMILY = "aid_exchange"
+
+STATUS_OPEN = "open"
+STATUS_EXPIRED = "expired"
+STATUS_COMPLETED = "completed"
+REQUEST_STATUSES = (STATUS_OPEN, STATUS_EXPIRED, STATUS_COMPLETED)
+
+# Constants Registry. Data constants (tuples), not structural code
+# assumptions - detection code checks membership, it never spells the string.
+AID_REQUEST_QUALIFYING_EVENT_TYPES = ("social_request_help",)
+# The measured organic driver (D2): the sealed legacy trigger, 17 accepted
+# requests / 308 ticks. Same event family group_carriage transmission reads.
+AID_RESPONSE_QUALIFYING_EVENT_TYPES = ("social_give",)
+# The committed give action ("give" on the person entity; living_settlement
+# routes give through build_social_action_proposal -> proposal/event type
+# "social_give", resource_kind "food", quantity 1 by builder default).
+
+AID_REQUEST_DUE_TICKS = 8
+# Cited provenance (D2): the legacy commitment window, due_tick = tick + 8
+# (living_settlement_domain.py:322, the REQUEST_HELP candidate) - not a new
+# number.
+
+AID_NORM_FORMATION_COUNT = None  # G2 N: calibration GAP per contract - None
+# disables formation until the post-build calibration fills it from the
+# probe-build's measured completed-exchange distribution (FIX 3 no-anchor
+# rule). Never invent a number here.
+
+
+@dataclass(frozen=True)
+class AidExchangeLimits:
+    open_requests: int = 28
+    # 4x the measured peak of 7 outstanding requests (150-tick request-side
+    # probe, pre-registration Step 1) - derivation-shown per D7.
+    completions: int = 64          # bounded ledger, FIFO-oldest-terminal
+    processed_request_event_ids: int = 96  # the cited family constant
+    # (mirrors group_carriage.processed_transmission_keys / group_norm
+    # processed_norm_keys - same idempotence-guard role).
+    causal_parents: int = 16       # cited family constant (carriage)
+    provenance_refs: int = 16      # cited family constant (carriage)
+    payload_target_bytes: int = 24 * 1024  # cited family constant (carriage)
+    proposal_bytes: int = 32 * 1024        # cited family constant (carriage)
+
+
+LIMITS = AidExchangeLimits()
+
+
+class AidExchangeContractError(ValueError):
+    """Raised when canonical Stage 8C Leg A state cannot be interpreted safely."""
+
+
+# Stable reason codes (mirroring group_carriage's set)
+REASON_INVALID = "aid_exchange.invalid"
+REASON_VERSION = "aid_exchange.invalid_version"
+REASON_REGISTRY_ID = "aid_exchange.invalid_registry_id"
+REASON_SCOPE = "aid_exchange.invalid_mutation_scope"
+REASON_SCHEMA = "aid_exchange.invalid_registry_schema"
+REASON_REVISION = "aid_exchange.invalid_revision"
+REASON_PAYLOAD = "aid_exchange.payload_limit"
+REASON_MUTATION = "aid_exchange.mutation_mismatch"
+REASON_METADATA = "aid_exchange.metadata_mismatch"
+REASON_LIMIT = "aid_exchange.request_limit"
+REASON_REQUEST = "aid_exchange.invalid_request"
+REASON_COUNTER = "aid_exchange.counter_regression"
+REASON_NORM = "aid_exchange.invalid_norm"
+
+FORBIDDEN_FIELDS = frozenset({
+    "inventory", "authority", "obedience", "orders", "law", "command", "punishment",
+})
+
+
+def empty_aid_exchange_registry(tick: int = 0) -> dict:
+    return {
+        "type": "aid_exchange_registry",
+        "schema_version": AID_EXCHANGE_REGISTRY_VERSION,
+        "revision": 0,
+        "open_requests": {},
+        "completions": {},
+        "processed_request_event_ids": [],
+        "completed_exchange_count": 0,
+        # aid_norm: absent until formed (D1) - {formed_tick, formation_count}.
+        "created_tick": int(tick),
+        "last_updated_tick": int(tick),
+    }
+
+
+def aid_request_id(source_event_id: str) -> str:
+    """Deterministic request id derived from the source accepted event id."""
+    return "aid-req-" + canonical_hash([str(source_event_id)])[:16]
+
+
+def _bounded_ids(values, limit: int = LIMITS.provenance_refs) -> list[str]:
+    return sorted(set(str(value) for value in (values or []) if value))[-limit:]
+
+
+def _accepted_action(entity: dict) -> dict | None:
+    """The entity's committed action, if any (mirrors group_carriage_contracts /
+    association_contracts ``_accepted_action`` - the accepted-action seam Stage
+    7A already reads; each contracts module owns its small derivations)."""
+    action = entity.get("action")
+    if not isinstance(action, dict) or not action.get("accepted_event_id"):
+        return None
+    return action
+
+
+def _living_person(entity) -> bool:
+    return (
+        isinstance(entity, dict)
+        and entity.get("type") == "person"
+        and entity.get("alive", True)
+    )
+
+
+def derive_aid_exchange_changes(entities: dict, tick: int) -> dict:
+    """Return the deterministic Stage 8C Leg A changes for this tick.
+
+    {"opens": [{"request_id", "requester_id", "responder_id", "source_event_id"}],
+     "completions": [{"request_id", "requester_id", "responder_id", "response_event_id"}],
+     "expiries": [{"request_id", "source_event_id"}]}
+
+    Reads person accepted actions (prior-frame seam) plus the existing
+    registry (for idempotence). Registry-local derivation only.
+    """
+    registry = entities.get(AID_EXCHANGE_REGISTRY_ID) or {}
+    if not isinstance(registry, dict):
+        registry = {}
+    open_requests = registry.get("open_requests") or {}
+    completions_ledger = registry.get("completions") or {}
+    processed = set(registry.get("processed_request_event_ids") or [])
+
+    # 1. Open new requests: a living person whose committed accepted action is
+    #    the qualifying social request, targeted at another living person.
+    #    Idempotent via processed_request_event_ids (and the derived
+    #    request_id itself, which is a pure function of the source event id).
+    opens: list[dict] = []
+    for person_id in sorted(entities):
+        person = entities[person_id]
+        if not _living_person(person):
+            continue
+        action = _accepted_action(person)
+        if not action:
+            continue
+        committed_event_type = f"social_{action.get('type')}"
+        if committed_event_type not in AID_REQUEST_QUALIFYING_EVENT_TYPES:
+            continue
+        source_event_id = action.get("accepted_event_id")
+        if source_event_id in processed:
+            continue
+        responder_id = action.get("target_entity_id")
+        if not responder_id or responder_id == person_id:
+            continue
+        if not _living_person(entities.get(responder_id)):
+            continue
+        request_id = aid_request_id(source_event_id)
+        if request_id in open_requests or request_id in completions_ledger:
+            continue
+        opens.append({
+            "request_id": request_id,
+            "requester_id": person_id,
+            "responder_id": responder_id,
+            "source_event_id": source_event_id,
+        })
+
+    # 2. Complete: an accepted give by the responder of an open, unexpired
+    #    request, targeted at that request's requester. One give (one accepted
+    #    event) completes at most one request; the request's own open->
+    #    completed status transition is the cross-tick idempotence guard.
+    used_response_ids = {
+        rec.get("response_event_id")
+        for rec in completions_ledger.values() if isinstance(rec, dict)
+    }
+    completions: list[dict] = []
+    for request_id in sorted(open_requests):
+        record = open_requests[request_id]
+        if not isinstance(record, dict) or record.get("status") != STATUS_OPEN:
+            continue
+        if int(tick) >= int(record.get("due_tick", tick)):
+            continue  # past due: expiry, never completion
+        responder_id = record.get("responder_id")
+        responder = entities.get(responder_id)
+        if not _living_person(responder):
+            continue
+        action = _accepted_action(responder)
+        if not action:
+            continue
+        committed_event_type = f"social_{action.get('type')}"
+        if committed_event_type not in AID_RESPONSE_QUALIFYING_EVENT_TYPES:
+            continue
+        if action.get("target_entity_id") != record.get("requester_id"):
+            continue
+        response_event_id = action.get("accepted_event_id")
+        if response_event_id in used_response_ids:
+            continue
+        used_response_ids.add(response_event_id)
+        completions.append({
+            "request_id": request_id,
+            "requester_id": record.get("requester_id"),
+            "responder_id": responder_id,
+            "response_event_id": response_event_id,
+        })
+
+    # 3. Expire: registry-local transition only (D2) - never a person write,
+    #    never a sanction (forbidden fields stay forbidden).
+    expiries: list[dict] = []
+    for request_id in sorted(open_requests):
+        record = open_requests[request_id]
+        if not isinstance(record, dict) or record.get("status") != STATUS_OPEN:
+            continue
+        if int(tick) < int(record.get("due_tick", tick)):
+            continue
+        expiries.append({
+            "request_id": request_id,
+            "source_event_id": record.get("source_event_id"),
+        })
+
+    opens.sort(key=lambda o: o["request_id"])
+    completions.sort(key=lambda c: c["request_id"])
+    expiries.sort(key=lambda e: e["request_id"])
+    # Bounded output: never derive more opens than the registry could ever
+    # hold (the open_requests cap itself, D7).
+    return {
+        "opens": opens[:LIMITS.open_requests],
+        "completions": completions,
+        "expiries": expiries,
+    }
+
+
+def _has_changes(changes: dict) -> bool:
+    return bool(
+        changes.get("opens") or changes.get("completions") or changes.get("expiries")
+    )
+
+
+def _request_record(entry: dict, tick: int) -> dict:
+    return {
+        "requester_id": entry["requester_id"],
+        "responder_id": entry["responder_id"],
+        "opened_tick": int(tick),
+        "due_tick": int(tick) + AID_REQUEST_DUE_TICKS,
+        "source_event_id": entry["source_event_id"],
+        "status": STATUS_OPEN,
+        "created_event_id": None,
+        "last_event_id": None,
+    }
+
+
+def advance_aid_exchange_registry(
+    existing: dict | None, changes: dict, tick: int,
+) -> tuple[dict, list[dict]]:
+    """Advance the aid-exchange registry deterministically.
+
+    Order of application is fixed: completions, then expiries, then opens
+    (so compaction for new opens sees this tick's fresh terminal statuses),
+    then norm formation. ``completed_exchange_count`` is the monotonic G2
+    counter and carries the norm-formation load - ledger pruning NEVER
+    touches it (the 8B F3 eviction lesson: never evict state that is still
+    load-bearing; here the load-bearing state is the counter, so the ledger
+    is safely prunable).
+    """
+    if existing:
+        if existing.get("schema_version") != AID_EXCHANGE_REGISTRY_VERSION:
+            raise AidExchangeContractError(
+                f"unsupported aid exchange schema: {existing.get('schema_version')}"
+            )
+        registry = copy.deepcopy(existing)
+    else:
+        registry = empty_aid_exchange_registry(tick)
+
+    open_requests = copy.deepcopy(registry.get("open_requests") or {})
+    completions_ledger = copy.deepcopy(registry.get("completions") or {})
+    processed = list(registry.get("processed_request_event_ids") or [])
+    processed_set = set(processed)
+    completed_count = int(registry.get("completed_exchange_count", 0))
+    transitions: list[dict] = []
+
+    # Completions first: mark completed, append ledger, bump the counter.
+    for entry in sorted(changes.get("completions") or [], key=lambda c: c["request_id"]):
+        request_id = entry["request_id"]
+        record = open_requests.get(request_id)
+        if not isinstance(record, dict) or record.get("status") != STATUS_OPEN:
+            continue
+        if request_id in completions_ledger:
+            continue
+        record["status"] = STATUS_COMPLETED
+        completions_ledger[request_id] = {
+            "response_event_id": entry["response_event_id"],
+            "completed_tick": int(tick),
+        }
+        completed_count += 1
+        transitions.append({"kind": "complete", "request_id": request_id})
+
+    # Expiries: registry-local status transition only.
+    for entry in sorted(changes.get("expiries") or [], key=lambda e: e["request_id"]):
+        request_id = entry["request_id"]
+        record = open_requests.get(request_id)
+        if not isinstance(record, dict) or record.get("status") != STATUS_OPEN:
+            continue
+        record["status"] = STATUS_EXPIRED
+        transitions.append({"kind": "expire", "request_id": request_id})
+
+    # Opens: deterministic compaction makes room by pruning TERMINAL records
+    # oldest-first ((opened_tick, request_id)); an open-status record is never
+    # evicted. With no terminal room, the new open is capacity-deferred and
+    # retried next tick (its event id is only marked processed when actually
+    # written), so the registry is never unbounded.
+    def _make_room() -> bool:
+        if len(open_requests) < LIMITS.open_requests:
+            return True
+        terminal = sorted(
+            (rid for rid, rec in sorted(open_requests.items())
+             if isinstance(rec, dict) and rec.get("status") != STATUS_OPEN),
+            key=lambda rid: (int(open_requests[rid].get("opened_tick", 0)), rid),
+        )
+        if not terminal:
+            return False
+        del open_requests[terminal[0]]
+        return True
+
+    for entry in sorted(changes.get("opens") or [], key=lambda o: o["request_id"]):
+        request_id = entry["request_id"]
+        if request_id in open_requests or request_id in completions_ledger:
+            continue
+        if entry["source_event_id"] in processed_set:
+            continue
+        if not _make_room():
+            continue  # capacity-deferred: retry next tick
+        open_requests[request_id] = _request_record(entry, tick)
+        processed.append(entry["source_event_id"])
+        processed_set.add(entry["source_event_id"])
+        transitions.append({"kind": "open", "request_id": request_id})
+
+    # Ledger pruning: FIFO-oldest-terminal by (completed_tick, request_id).
+    # The counter above is deliberately NOT derived from this ledger.
+    if len(completions_ledger) > LIMITS.completions:
+        ordered = sorted(
+            completions_ledger,
+            key=lambda rid: (int(completions_ledger[rid].get("completed_tick", 0)), rid),
+        )
+        for rid in ordered[:len(completions_ledger) - LIMITS.completions]:
+            del completions_ledger[rid]
+
+    # Norm formation (D4/G2): gated on the calibration constant. While
+    # AID_NORM_FORMATION_COUNT is None, formation is disabled by design.
+    if (AID_NORM_FORMATION_COUNT is not None
+            and "aid_norm" not in registry
+            and completed_count >= int(AID_NORM_FORMATION_COUNT)):
+        registry["aid_norm"] = {
+            "formed_tick": int(tick),
+            "formation_count": completed_count,
+            "created_event_id": None,
+        }
+        transitions.append({"kind": "norm_formed", "request_id": None})
+
+    registry["open_requests"] = {rid: open_requests[rid] for rid in sorted(open_requests)}
+    registry["completions"] = {rid: completions_ledger[rid] for rid in sorted(completions_ledger)}
+    registry["processed_request_event_ids"] = processed[-LIMITS.processed_request_event_ids:]
+    registry["completed_exchange_count"] = completed_count
+    registry["revision"] = int(registry.get("revision", 0)) + 1
+    registry["last_updated_tick"] = int(tick)
+    transitions.sort(key=lambda t: (t["kind"], t["request_id"] or ""))
+    return registry, transitions
+
+
+def _proposed_registry(proposal: dict) -> dict | None:
+    mutation = proposal.get("mutation") or {}
+    return (
+        (mutation.get("new_entities") or {}).get(AID_EXCHANGE_REGISTRY_ID)
+        or (mutation.get("entity_updates") or {}).get(AID_EXCHANGE_REGISTRY_ID)
+    )
+
+
+def build_aid_exchange_proposal(
+    entities: dict,
+    tick: int,
+    *,
+    changes: dict | None = None,
+) -> dict | None:
+    existing = entities.get(AID_EXCHANGE_REGISTRY_ID)
+    if existing is not None and (
+            not isinstance(existing, dict)
+            or existing.get("schema_version") != AID_EXCHANGE_REGISTRY_VERSION):
+        return None
+    if changes is None:
+        changes = derive_aid_exchange_changes(entities, tick)
+    if not _has_changes(changes):
+        return None
+
+    registry, transitions = advance_aid_exchange_registry(existing, changes, tick)
+    if not transitions:
+        return None  # every candidate change was deferred; nothing to commit
+
+    parents = []
+    for entry in changes.get("opens") or []:
+        if entry.get("source_event_id"):
+            parents.append(entry["source_event_id"])
+    for entry in changes.get("completions") or []:
+        if entry.get("response_event_id"):
+            parents.append(entry["response_event_id"])
+    for entry in changes.get("expiries") or []:
+        if entry.get("source_event_id"):
+            parents.append(entry["source_event_id"])
+    parent_ids = _bounded_ids(parents, LIMITS.causal_parents)
+    if not parent_ids:
+        return None
+
+    if existing:
+        mutation = {"entity_updates": {AID_EXCHANGE_REGISTRY_ID: registry}, "new_entities": {}}
+        prior_revision = int(existing.get("revision", 0))
+        preconditions = [{
+            "entity_id": AID_EXCHANGE_REGISTRY_ID, "field": "revision",
+            "op": "eq", "value": prior_revision,
+        }]
+    else:
+        mutation = {"new_entities": {AID_EXCHANGE_REGISTRY_ID: registry}, "entity_updates": {}}
+        prior_revision = None
+        preconditions = []
+
+    payload_bytes = len(canonical_json(registry).encode("utf-8"))
+    metadata = {
+        "schema_version": AID_EXCHANGE_VERSION,
+        "registry_id": AID_EXCHANGE_REGISTRY_ID,
+        "prior_revision": prior_revision,
+        "next_revision": int(registry["revision"]),
+        "changes": copy.deepcopy(changes),
+        "transitions": copy.deepcopy(transitions),
+        "open_request_count": len(registry["open_requests"]),
+        "completed_exchange_count": int(registry["completed_exchange_count"]),
+        "payload_bytes": payload_bytes,
+    }
+    return {
+        "proposal_family": PROPOSAL_FAMILY,
+        "proposal_type": PROPOSAL_TYPE,
+        "proposer_engine_id": "aid_exchange",
+        "proposer_engine_version": "1.0.0",
+        "entity_id": AID_EXCHANGE_REGISTRY_ID,
+        "causal_parent_event_ids": parent_ids,
+        "is_exogenous": False,
+        "requested_time": int(tick),
+        "phase": "agent",
+        "engine_priority": 85,  # next culture-ladder slot below group_carriage (86)
+        "touched_scope": [AID_EXCHANGE_REGISTRY_ID],
+        "preconditions": preconditions,
+        "mutation": mutation,
+        "aid_exchange_update": metadata,
+        "explanation": (
+            f"aid exchange registry revision {registry['revision']}; "
+            f"opens={len(changes.get('opens') or [])} "
+            f"completions={len(changes.get('completions') or [])} "
+            f"expiries={len(changes.get('expiries') or [])}"
+        ),
+    }
+
+
+def validate_aid_exchange_proposal(proposal: dict, entities: dict) -> str | None:
+    """Core-owned validation. None means ok; non-None is a stable reason code."""
+    metadata = proposal.get("aid_exchange_update")
+    if metadata is None:
+        # Marker-gated: a proposal that writes the aid registry WITHOUT the
+        # aid_exchange_update marker must not slip past validation.
+        mutation = proposal.get("mutation") or {}
+        if (AID_EXCHANGE_REGISTRY_ID in (mutation.get("new_entities") or {})
+                or AID_EXCHANGE_REGISTRY_ID in (mutation.get("entity_updates") or {})):
+            return REASON_INVALID
+        return None
+    if not isinstance(metadata, dict) or metadata.get("schema_version") != AID_EXCHANGE_VERSION:
+        return REASON_VERSION
+    if (proposal.get("entity_id") != AID_EXCHANGE_REGISTRY_ID
+            or metadata.get("registry_id") != AID_EXCHANGE_REGISTRY_ID):
+        return REASON_REGISTRY_ID
+
+    mutation = proposal.get("mutation") or {}
+    new_entities = mutation.get("new_entities") or {}
+    entity_updates = mutation.get("entity_updates") or {}
+    removed = mutation.get("removed_entities") or []
+    # Scope gate (Category-2 single-owner pattern, per group_carriage): every
+    # lifecycle write is registry-local - this family never writes persons.
+    if set(new_entities) - {AID_EXCHANGE_REGISTRY_ID} or set(entity_updates) - {AID_EXCHANGE_REGISTRY_ID} or removed:
+        return REASON_SCOPE
+    if AID_EXCHANGE_REGISTRY_ID in new_entities and AID_EXCHANGE_REGISTRY_ID in entity_updates:
+        return REASON_SCOPE
+    registry = _proposed_registry(proposal)
+    if not isinstance(registry, dict) or registry.get("schema_version") != AID_EXCHANGE_REGISTRY_VERSION:
+        return REASON_SCHEMA
+
+    payload_bytes = len(canonical_json(registry).encode("utf-8"))
+    if payload_bytes > LIMITS.proposal_bytes or int(metadata.get("payload_bytes", -1)) != payload_bytes:
+        return REASON_PAYLOAD
+
+    existing = entities.get(AID_EXCHANGE_REGISTRY_ID)
+    if existing and AID_EXCHANGE_REGISTRY_ID in new_entities:
+        return REASON_REVISION
+    expected_revision = int(existing.get("revision", 0)) + 1 if existing else 1
+    if int(registry.get("revision", -1)) != expected_revision:
+        return REASON_REVISION
+    if metadata.get("prior_revision") != (int(existing.get("revision", 0)) if existing else None):
+        return REASON_REVISION
+    if int(metadata.get("next_revision", -1)) != expected_revision:
+        return REASON_REVISION
+
+    required = {
+        (c.get("entity_id"), c.get("field"), c.get("op"), c.get("value"))
+        for c in (proposal.get("preconditions") or [])
+    }
+    if existing and (AID_EXCHANGE_REGISTRY_ID, "revision", "eq", int(existing.get("revision", 0))) not in required:
+        return REASON_REVISION
+
+    changes = metadata.get("changes")
+    if not isinstance(changes, dict):
+        return REASON_METADATA
+    if (not isinstance(changes.get("opens"), list)
+            or not isinstance(changes.get("completions"), list)
+            or not isinstance(changes.get("expiries"), list)):
+        return REASON_METADATA
+
+    # Re-derive from the current canonical frame and require CANONICAL BYTE
+    # equality (not Python ==) against the submitted changes - a forged
+    # requester_id / responder_id / source_event_id / response_event_id
+    # cannot survive.
+    derived = derive_aid_exchange_changes(entities, int(proposal.get("requested_time", 0)))
+    if canonical_json(changes) != canonical_json(derived):
+        return REASON_METADATA
+
+    # Advance the TRUSTED freshly-derived changes (not the submission) and
+    # require the submitted registry + transitions to be byte-exact.
+    try:
+        expected_registry, transitions = advance_aid_exchange_registry(
+            existing, derived, int(proposal.get("requested_time", 0)),
+        )
+    except (TypeError, ValueError, AidExchangeContractError):
+        return REASON_SCHEMA
+    if canonical_json(expected_registry) != canonical_json(registry):
+        return REASON_MUTATION
+    if canonical_json(metadata.get("transitions")) != canonical_json(transitions):
+        return REASON_METADATA
+    if int(metadata.get("open_request_count", -1)) != len(registry.get("open_requests") or {}):
+        return REASON_METADATA
+    if int(metadata.get("completed_exchange_count", -1)) != int(registry.get("completed_exchange_count", -1)):
+        return REASON_METADATA
+
+    if len(registry.get("open_requests") or {}) > LIMITS.open_requests:
+        return REASON_LIMIT
+    if len(registry.get("completions") or {}) > LIMITS.completions:
+        return REASON_LIMIT
+    if len(registry.get("processed_request_event_ids") or []) > LIMITS.processed_request_event_ids:
+        return REASON_LIMIT
+    if existing and int(registry.get("completed_exchange_count", 0)) < int(existing.get("completed_exchange_count", 0)):
+        return REASON_COUNTER  # the G2 counter is monotonic; pruning never lowers it
+
+    for request_id, record in sorted((registry.get("open_requests") or {}).items()):
+        if not isinstance(record, dict) or FORBIDDEN_FIELDS & set(record):
+            return REASON_REQUEST
+        if record.get("status") not in REQUEST_STATUSES:
+            return REASON_REQUEST
+        if not record.get("requester_id") or not record.get("responder_id"):
+            return REASON_REQUEST
+        if record.get("requester_id") == record.get("responder_id"):
+            return REASON_REQUEST
+        if not record.get("source_event_id"):
+            return REASON_REQUEST
+    for request_id, record in sorted((registry.get("completions") or {}).items()):
+        if not isinstance(record, dict) or FORBIDDEN_FIELDS & set(record):
+            return REASON_REQUEST
+        if not record.get("response_event_id"):
+            return REASON_REQUEST
+    aid_norm = registry.get("aid_norm")
+    if aid_norm is not None:
+        if AID_NORM_FORMATION_COUNT is None:
+            return REASON_NORM  # formation is calibration-gated; cannot exist yet
+        if not isinstance(aid_norm, dict) or FORBIDDEN_FIELDS & set(aid_norm):
+            return REASON_NORM
+        if int(aid_norm.get("formation_count", -1)) < int(AID_NORM_FORMATION_COUNT):
+            return REASON_NORM
+    return None
+
+
+def stamp_aid_exchange_provenance(proposal: dict, mutation: dict, event_id: str) -> None:
+    """Stamp created/last event ids on the records this proposal transitioned.
+
+    Mirrors group_carriage (amendment 2 style): no pending_* staging keys -
+    ``metadata["transitions"]`` already lists exactly which registry records
+    changed this tick.
+    """
+    metadata = proposal.get("aid_exchange_update")
+    if not isinstance(metadata, dict):
+        return
+    registry = (
+        (mutation.get("new_entities") or {}).get(AID_EXCHANGE_REGISTRY_ID)
+        or (mutation.get("entity_updates") or {}).get(AID_EXCHANGE_REGISTRY_ID)
+    )
+    if not isinstance(registry, dict):
+        return
+    open_requests = registry.get("open_requests") or {}
+    for transition in metadata.get("transitions") or []:
+        if transition.get("kind") == "norm_formed":
+            aid_norm = registry.get("aid_norm")
+            if isinstance(aid_norm, dict) and aid_norm.get("created_event_id") is None:
+                aid_norm["created_event_id"] = event_id
+            continue
+        record = open_requests.get(transition.get("request_id"))
+        if not isinstance(record, dict):
+            continue
+        if record.get("created_event_id") is None:
+            record["created_event_id"] = event_id
+        record["last_event_id"] = event_id
+    metadata["accepted_event_id"] = event_id
+
+
+def aid_exchange_diagnostics(registry: dict, tick: int) -> dict:
+    open_requests = registry.get("open_requests") or {}
+    by_status = {status: 0 for status in REQUEST_STATUSES}
+    for record in open_requests.values():
+        status = record.get("status")
+        if status in by_status:
+            by_status[status] += 1
+    return {
+        "schema_version": "aid-exchange-diagnostics-v1",
+        "tick": int(tick),
+        "registry_revision": int(registry.get("revision", 0)),
+        "request_count": len(open_requests),
+        "open_request_count": by_status[STATUS_OPEN],
+        "expired_request_count": by_status[STATUS_EXPIRED],
+        "completed_request_count": by_status[STATUS_COMPLETED],
+        "completion_ledger_count": len(registry.get("completions") or {}),
+        "completed_exchange_count": int(registry.get("completed_exchange_count", 0)),
+        "aid_norm_formed": "aid_norm" in registry,
+        "processed_request_event_count": len(registry.get("processed_request_event_ids") or []),
+        "caps": {
+            "open_requests": LIMITS.open_requests,
+            "completions": LIMITS.completions,
+            "processed_request_event_ids": LIMITS.processed_request_event_ids,
+            "causal_parents": LIMITS.causal_parents,
+            "payload_target_bytes": LIMITS.payload_target_bytes,
+            "proposal_bytes": LIMITS.proposal_bytes,
+        },
+        "constants": {
+            "aid_request_due_ticks": AID_REQUEST_DUE_TICKS,
+            "aid_norm_formation_count": AID_NORM_FORMATION_COUNT,
+            "request_qualifying_event_types": list(AID_REQUEST_QUALIFYING_EVENT_TYPES),
+            "response_qualifying_event_types": list(AID_RESPONSE_QUALIFYING_EVENT_TYPES),
+        },
+    }
